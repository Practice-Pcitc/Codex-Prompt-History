{
  "description": "Standalone local Prompt History recorder",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /absolute/path/to/Codex-Prompt-History/hook/prompt_hook.py",
            "commandWindows": "cmd.exe /d /s /c C:\\absolute\\path\\to\\Codex-Prompt-History/hook\\run_prompt_hook.cmd",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /absolute/path/to/Codex-Prompt-History/hook/prompt_hook.py",
            "commandWindows": "cmd.exe /d /s /c C:\\absolute\\path\\to\\Codex-Prompt-History/hook\\run_prompt_hook.cmd",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /absolute/path/to/Codex-Prompt-History/hook/prompt_hook.py",
            "commandWindows": "cmd.exe /d /s /c C:\\absolute\\path\\to\\Codex-Prompt-History/hook\\run_prompt_hook.cmd",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /absolute/path/to/Codex-Prompt-History/hook/prompt_hook.py",
            "commandWindows": "cmd.exe /d /s /c C:\\absolute\\path\\to\\Codex-Prompt-History/hook\\run_prompt_hook.cmd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
