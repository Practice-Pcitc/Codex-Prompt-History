{
  "name": "codex-prompt-history-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "element-plus": "^2.10.7",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.5"
  }
}
